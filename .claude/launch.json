{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "server.main:app", "--reload", "--port", "8000", "--app-dir", "apps/server/src"],
      "port": 8000
    }
  ]
}
