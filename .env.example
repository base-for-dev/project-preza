# Inference provider for LLM/VLM/text-to-image calls (open-weight, <=35B, Apache-2.0/MIT — see MODELS.md)
# Selection stage: OpenRouter (OpenAI-compatible). Top-10 stage: swap to the VK-provided endpoint.
INFERENCE_API_BASE=https://openrouter.ai/api/v1
INFERENCE_API_KEY=
# Per-call read timeout (seconds). Bump for slow shared/free model pools that
# generate a full outline in >120s; drop for a fast dedicated endpoint.
INFERENCE_REQUEST_TIMEOUT=180
# Retries after the first attempt on a transient transport failure (dropped
# connection / SSL EOF). Not applied to read timeouts or HTTP error statuses.
INFERENCE_MAX_RETRIES=1

# Unsplash photo search for slides that ask for on-topic imagery. Optional —
# unset leaves template placeholder images untouched (see packages/images).
# Get a key: https://unsplash.com/oauth/applications -> New Application ->
# copy the "Access Key" (not the Secret Key).
UNSPLASH_ACCESS_KEY=

# LibreOffice `soffice`, only if it is not on PATH (vector .pdf export, server-side previews).
# Optional: without it the browser draws the PDF and the previews itself. Read from the
# process environment (docker compose passes this file in; locally: SOFFICE_PATH=... make start).
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# Ports (scripts/dev.sh moves the web app to the next free port if 3000 is busy)
SERVER_PORT=8000
WEB_PORT=3000

# Where the browser finds the API
NEXT_PUBLIC_API_URL=http://localhost:8000
