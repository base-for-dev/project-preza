# Inference provider for LLM/VLM/text-to-image calls (open-weight, <=35B, Apache-2.0/MIT — see MODELS.md)
# Selection stage: OpenRouter (OpenAI-compatible). Top-10 stage: swap to the VK-provided endpoint.
INFERENCE_API_BASE=https://openrouter.ai/api/v1
INFERENCE_API_KEY=
# Per-call read timeout (seconds). Bump for slow shared/free model pools that
# generate a full outline in >120s; drop for a fast dedicated endpoint.
INFERENCE_REQUEST_TIMEOUT=180
# Retries after the first attempt on a transient transport failure (dropped
# connection / SSL EOF). Not applied to read timeouts or HTTP error statuses.
INFERENCE_MAX_RETRIES=1

# apps/server
SERVER_PORT=8000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000
