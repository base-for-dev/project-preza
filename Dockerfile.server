# API: FastAPI + the pipeline packages. LibreOffice is installed for the vector PDF
# export and the server-side slide preview; without it both fall back to the browser.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-impress fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages packages
COPY apps/server apps/server
COPY skills skills
COPY evals/generate_behance_templates.py evals/generate_behance_templates.py
RUN uv sync --frozen --no-dev --package preza-server

EXPOSE 8000
CMD ["uv", "run", "--no-sync", "--package", "preza-server", "uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
